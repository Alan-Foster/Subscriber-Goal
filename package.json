{
  "private": true,
  "name": "subscriber-goal",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "assets:check": "node scripts/assets.mjs",
    "build": "vite build",
    "check": "npm run assets:check && npm run i18n:check && npm run type-check && npm run lint:fix && npm run prettier",
    "deploy": "npm run build && devvit upload",
    "dev": "devvit playtest",
    "format:check": "prettier --check .",
    "lint": "eslint ./src",
    "lint:ci": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "i18n:check": "node scripts/i18n.mjs && vitest run src/shared/i18n/catalog.test.ts",
    "i18n:export": "node scripts/i18n.mjs --export",
    "login": "devvit login",
    "launch": "npm run build && npm run deploy && devvit publish",
    "prettier": "prettier-package-json --write ./package.json && prettier --write .",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:unit": "vitest run",
    "type-check": "tsc --build",
    "type-check:tests": "tsc -p src/shared/tsconfig.eslint.json && tsc -p src/client/tsconfig.eslint.json && tsc -p src/server/tsconfig.eslint.json",
    "verify": "npm run assets:check && npm run format:check && npm run lint:ci && npm run type-check && npm run type-check:tests && npm run i18n:check && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@devvit/analytics": "0.15.6",
    "@devvit/notifications": "0.15.6",
    "@devvit/protos": "0.15.6",
    "@devvit/shared-types": "0.15.6",
    "@devvit/start": "0.15.6",
    "@devvit/web": "0.15.6",
    "express": "5.3.0",
    "intl-messageformat": "10.7.18",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@devvit/reddit": "0.15.6",
    "@eslint/js": "9.39.5",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/vite": "4.1.18",
    "@types/express": "5.0.6",
    "@types/node": "22.19.7",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "devvit": "0.15.6",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "15.15.0",
    "prettier": "3.9.10",
    "prettier-package-json": "2.8.0",
    "tailwindcss": "4.1.18",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
