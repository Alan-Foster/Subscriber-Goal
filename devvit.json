{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "subscriber-goal",
  "dev": {
    "subreddit": "subscriber_goal_dev"
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "app.html",
        "height": "regular"
      },
      "subscribe-only": {
        "entry": "subscribe-only.html",
        "styles": {
          "height": 100
        }
      },
      "app": {
        "entry": "app.html",
        "height": "regular"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "media": {
    "dir": "assets"
  },
  "marketingAssets": {
    "icon": "assets/icon.png"
  },
  "permissions": {
    "journeys": true,
    "media": true,
    "realtime": true,
    "redis": true,
    "reddit": {
      "enable": true,
      "asUser": ["SUBSCRIBE_TO_SUBREDDIT", "SUBMIT_POST"]
    }
  },
  "menu": {
    "items": [
      {
        "label": "Sub Goal - Create a New Goal",
        "description": "Create a new subscriber goal post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/create-goal"
      },
      {
        "label": "Sub Goal - Delete This Goal",
        "description": "Delete the current subscriber goal post",
        "location": "post",
        "forUserType": "moderator",
        "postFilter": "currentApp",
        "endpoint": "/internal/menu/delete-goal"
      },
      {
        "label": "Sub Goal - Erase Another User's Data",
        "description": "Moderator tool to erase subscriber data for a specific user",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/erase-data"
      },
      {
        "label": "Sub Goal - Erase My User Data",
        "description": "Erase your own Sub Goal user data",
        "location": "subreddit",
        "endpoint": "/internal/menu/erase-my-data"
      }
    ]
  },
  "forms": {
    "createGoalSetupForm": "/internal/form/create-goal/setup",
    "createSubscriberGoalForm": "/internal/form/create-goal/subscriber-goal",
    "createSubscribeOnlyForm": "/internal/form/create-goal/subscribe-only",
    "createCtaOnlyForm": "/internal/form/create-goal/cta-only",
    "createSubscriberGoalFollowUpForm": "/internal/form/create-goal/subscriber-goal/follow-up",
    "createSubscribeOnlyFollowUpForm": "/internal/form/create-goal/subscribe-only/follow-up",
    "createCtaOnlyFollowUpForm": "/internal/form/create-goal/cta-only/follow-up",
    "deleteGoalForm": "/internal/form/delete-goal",
    "eraseDataForm": "/internal/form/erase-data",
    "eraseMyDataForm": "/internal/form/erase-my-data"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onAppUpgrade": "/internal/triggers/on-app-upgrade",
    "onModAction": "/internal/triggers/on-mod-action",
    "onPostCreate": "/internal/triggers/on-post-create"
  },
  "scheduler": {
    "tasks": {
      "posts-updater-job": {
        "endpoint": "/internal/scheduler/posts-updater-job",
        "cron": "*/1 * * * *"
      },
      "milestone-notification-job": {
        "endpoint": "/internal/scheduler/milestone-notification-job"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
